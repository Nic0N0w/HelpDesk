<Window x:Class="HelpDeskPro.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDeskPro - Client" Height="450" Width="800">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Tickets}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" />
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Created By" Binding="{Binding CreatedByName}" Width="150" />
                <DataGridTextColumn Header="Assigned To" Binding="{Binding AssignedToName}" Width="150" />
                <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>