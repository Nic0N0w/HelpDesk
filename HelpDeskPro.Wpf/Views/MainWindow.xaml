<Window x:Class="HelpDeskPro.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk Pro" Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0C4DE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter Margin="20,12"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Topbar ── -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="20,0">
                <TextBlock Text="🖥️ HelpDesk Pro" Foreground="White" FontSize="18"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameText" Foreground="White" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border x:Name="RoleBadge" CornerRadius="10" Padding="8,2" Margin="0,0,16,0">
                        <TextBlock x:Name="RoleText" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <!-- Abmelden Button - ohne TemplateBinding -->
                    <Button Content="Abmelden" Click="LogoutButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="logoutBorder"
                                        Background="Transparent"
                                        BorderBrush="#44FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12,5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="logoutBorder" Property="Background" Value="#22FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>
                            <SolidColorBrush Color="White"/>
                        </Button.Foreground>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Sidebar ── -->
        <Border Grid.Row="1" Grid.Column="0" Background="#16324F">
            <StackPanel Margin="0,16,0,0">
                <Button x:Name="BtnAllTickets" Content="📋  Alle Tickets"
                        Click="Navigate_AllTickets" Tag="all"
                        Style="{StaticResource NavButton}"/>
                <Button x:Name="BtnMyTickets" Content="👤  Meine Tickets"
                        Click="Navigate_MyTickets" Tag="my"
                        Style="{StaticResource NavButton}"/>
                <Button x:Name="BtnAdmin" Content="⚙️  Admin-Panel"
                        Click="Navigate_Admin" Tag="admin"
                        Style="{StaticResource NavButton}"
                        x:FieldModifier="private"/>
            </StackPanel>
        </Border>

        <!-- ── Content Frame ── -->
        <Frame x:Name="ContentFrame" Grid.Row="1" Grid.Column="1"
               NavigationUIVisibility="Hidden" Background="{StaticResource BackgroundBrush}"/>
    </Grid>
</Window>
