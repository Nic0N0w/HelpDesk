<Page x:Class="HelpDeskPro.Wpf.Views.TicketListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Title="Alle Tickets"
      d:DesignWidth="1000" d:DesignHeight="600"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📋 Alle Tickets" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
            <Button Content="+ Neues Ticket" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" Click="NewTicket_Click"/>
        </Grid>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16,12">
            <WrapPanel>
                <TextBox x:Name="SearchBox"
                         Width="220" Margin="0,0,10,0"
                         TextChanged="Filter_Changed">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍 Suchen..." Foreground="#AAAAAA" Margin="12,8"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <ComboBox x:Name="StatusFilter" Style="{StaticResource ModernComboBox}"
                          Width="140" Margin="0,0,10,0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Alle Status" IsSelected="True"/>
                    <ComboBoxItem Content="Open"/>
                    <ComboBoxItem Content="InProgress"/>
                    <ComboBoxItem Content="Closed"/>
                </ComboBox>
                <ComboBox x:Name="PriorityFilter" Style="{StaticResource ModernComboBox}"
                          Width="150" Margin="0,0,10,0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Alle Prioritäten" IsSelected="True"/>
                    <ComboBoxItem Content="Low"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="High"/>
                    <ComboBoxItem Content="Critical"/>
                </ComboBox>
                <Button Content="Zurücksetzen" Style="{StaticResource SecondaryButton}"
                        Click="ResetFilter_Click"/>
            </WrapPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="TicketGrid" Style="{StaticResource ModernDataGrid}"
                      MouseDoubleClick="TicketGrid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="*"/>
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,3" Margin="2"
                                        Background="{Binding Status, Converter={StaticResource StatusToBackground}}">
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Priorität" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Priority}"
                                           Foreground="{Binding Priority, Converter={StaticResource PriorityToColor}}"
                                           FontWeight="SemiBold" FontSize="12" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Erstellt von" Binding="{Binding CreatedByName}" Width="130"/>
                    <DataGridTextColumn Header="Zugewiesen" Binding="{Binding AssignedToName}" Width="130"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="90"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F6FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- Status Bar -->
        <TextBlock x:Name="CountText" Grid.Row="3" Foreground="#888888"
                   FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Right"/>
    </Grid>
</Page>
