<Page x:Class="HelpDeskPro.Wpf.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Title="Admin-Panel">
    <ScrollViewer>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="⚙️ Admin-Panel" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,20"/>

            <!-- Stats -->
            <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,24">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TotalCount" Text="0" FontSize="32" FontWeight="Black"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Gesamt" Foreground="#777777" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="OpenCount" Text="0" FontSize="32" FontWeight="Black"
                                   Foreground="#1565C0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Offen" Foreground="#777777" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="InProgressCount" Text="0" FontSize="32" FontWeight="Black"
                                   Foreground="#F57F17" HorizontalAlignment="Center"/>
                        <TextBlock Text="In Bearbeitung" Foreground="#777777" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="ClosedCount" Text="0" FontSize="32" FontWeight="Black"
                                   Foreground="#2E7D32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Geschlossen" Foreground="#777777" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Alle Tickets -->
            <TextBlock Grid.Row="2" Text="📋 Alle Tickets" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="AdminGrid" Style="{StaticResource ModernDataGrid}"
                          MouseDoubleClick="Grid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="*"/>
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" Margin="2"
                                            Background="{Binding Status, Converter={StaticResource StatusToBackground}}">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Priorität" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Priority}"
                                               Foreground="{Binding Priority, Converter={StaticResource PriorityToColor}}"
                                               FontWeight="SemiBold" FontSize="12" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ersteller" Binding="{Binding CreatedByName}" Width="130"/>
                        <DataGridTextColumn Header="Zugewiesen" Binding="{Binding AssignedToName}" Width="130"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F6FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
