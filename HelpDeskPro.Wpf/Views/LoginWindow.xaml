<Window x:Class="HelpDeskPro.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk Pro – Anmelden"
        Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1F4E79">

    <Grid>
        <Border Background="White" CornerRadius="12" Margin="30"
                Padding="36,32">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.25"/>
            </Border.Effect>
            <StackPanel>
                <!-- Logo -->
                <TextBlock Text="🖥️ HelpDesk Pro" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Internes IT-Support-Portal" FontSize="13"
                           Foreground="#666666" Margin="0,0,0,28"/>

                <!-- Error -->
                <Border x:Name="ErrorBorder" Background="#FFF0F0" BorderBrush="#FFCCCC"
                        BorderThickness="1" CornerRadius="6" Padding="12,8"
                        Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- User -->
                <TextBlock Text="Benutzer auswählen" FontSize="12" FontWeight="SemiBold"
                           Foreground="#333333" Margin="0,0,0,6"/>
                <ComboBox x:Name="UserComboBox" Style="{StaticResource ModernComboBox}"
                          DisplayMemberPath="." Margin="0,0,0,16"
                          SelectionChanged="UserComboBox_SelectionChanged"/>

                <!-- Password -->
                <TextBlock Text="Passwort (Demo)" FontSize="12" FontWeight="SemiBold"
                           Foreground="#333333" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox" Padding="10,8" FontSize="13"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"
                             Margin="0,0,0,24"/>

                <!-- Login Button -->
                <Button Content="Anmelden" Style="{StaticResource PrimaryButton}"
                        Height="42" FontSize="14" Click="LoginButton_Click"/>

                <TextBlock Text="💡 Demo: Benutzer wählen, beliebiges Passwort eingeben."
                           FontSize="11" Foreground="#999999" TextAlignment="Center"
                           Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
