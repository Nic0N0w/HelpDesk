@page "/"
@using HelpDeskPro.Frontend.Models
@using HelpDeskPro.Frontend.Services
@inject ApiService Api
@inject AuthState Auth
@inject NavigationManager Nav

<div class="page-header">
    <h2>📋 Alle Tickets</h2>
    <button class="btn-primary" @onclick="() => showCreate = true">+ Neues Ticket</button>
</div>

@* ── Filter-Leiste ── *@
<div class="filter-bar">
    <input class="form-input" placeholder="🔍 Suchen..." @bind="searchText" @bind:event="oninput" @onkeyup="ApplyFilter" />
    <select class="form-select" @bind="filterStatus" @bind:after="ApplyFilter">
        <option value="">Alle Status</option>
        <option value="Open">Open</option>
        <option value="InProgress">In Progress</option>
        <option value="Closed">Closed</option>
    </select>
    <select class="form-select" @bind="filterPriority" @bind:after="ApplyFilter">
        <option value="">Alle Prioritäten</option>
        <option value="Low">Low</option>
        <option value="Medium">Medium</option>
        <option value="High">High</option>
        <option value="Critical">Critical</option>
    </select>
    <button class="btn-secondary" @onclick="ResetFilter">Zurücksetzen</button>
</div>

@if (isLoading)
{
    <p class="loading">⏳ Tickets werden geladen…</p>
}
else if (tickets is null || !tickets.Any())
{
    <p class="empty">Keine Tickets gefunden.</p>
}
else
{
    <table class="ticket-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Titel</th>
                <th>Status</th>
                <th>Priorität</th>
                <th>Erstellt von</th>
                <th>Zugewiesen an</th>
                <th>Datum</th>
                <th>Aktion</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in tickets)
            {
                <tr>
                    <td>@t.Id</td>
                    <td class="ticket-title" @onclick="() => OpenDetail(t.Id)">@t.Title</td>
                    <td><span class="badge badge-@t.Status.ToString().ToLower()">@t.Status</span></td>
                    <td><span class="badge badge-priority-@t.Priority.ToString().ToLower()">@t.Priority</span></td>
                    <td>@t.CreatedByName</td>
                    <td>@(t.AssignedToName ?? "–")</td>
                    <td>@t.CreatedAt.ToShortDateString()</td>
                    <td><button class="btn-sm" @onclick="() => OpenDetail(t.Id)">Details</button></td>
                </tr>
            }
        </tbody>
    </table>
    <p class="result-count">@tickets.Count Ticket(s) gefunden</p>
}

@* ── Neues Ticket Modal ── *@
@if (showCreate)
{
    <div class="modal-overlay" @onclick="() => showCreate = false">
        <div class="modal" @onclick:stopPropagation>
            <h3>Neues Ticket erstellen</h3>
            @if (!string.IsNullOrEmpty(createError))
            {
                <div class="alert-error">@createError</div>
            }
            <div class="form-group">
                <label>Titel *</label>
                <input class="form-input" @bind="newTitle" placeholder="Kurze Beschreibung des Problems" />
            </div>
            <div class="form-group">
                <label>Beschreibung</label>
                <textarea class="form-textarea" @bind="newDescription" rows="3" placeholder="Details zum Problem…"></textarea>
            </div>
            <div class="form-group">
                <label>Priorität</label>
                <select class="form-select" @bind="newPriority">
                    <option value="0">Low</option>
                    <option value="1" selected>Medium</option>
                    <option value="2">High</option>
                    <option value="3">Critical</option>
                </select>
            </div>
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="() => showCreate = false">Abbrechen</button>
                <button class="btn-primary" @onclick="CreateTicket" disabled="@isSaving">
                    @(isSaving ? "Wird erstellt…" : "Erstellen")
                </button>
            </div>
        </div>
    </div>
}

@code {
    List<TicketDto>? tickets;
    bool isLoading = true;
    bool showCreate = false;
    bool isSaving = false;
    string searchText = "", filterStatus = "", filterPriority = "", createError = "";
    string newTitle = "", newDescription = "";
    int newPriority = 1;

    protected override async Task OnInitializedAsync() => await LoadTickets();

    async Task LoadTickets()
    {
        isLoading = true;
        try { tickets = await Api.GetTicketsAsync(
            string.IsNullOrEmpty(filterStatus) ? null : filterStatus,
            string.IsNullOrEmpty(filterPriority) ? null : filterPriority,
            string.IsNullOrEmpty(searchText) ? null : searchText); }
        finally { isLoading = false; }
    }

    async Task ApplyFilter() => await LoadTickets();

    async Task ResetFilter()
    {
        searchText = ""; filterStatus = ""; filterPriority = "";
        await LoadTickets();
    }

    void OpenDetail(int id) => Nav.NavigateTo($"/ticket/{id}");

    async Task CreateTicket()
    {
        createError = "";
        if (string.IsNullOrWhiteSpace(newTitle)) { createError = "Titel ist erforderlich."; return; }
        isSaving = true;
        var result = await Api.CreateTicketAsync(newTitle, newDescription, newPriority, Auth.CurrentUser!.Id);
        isSaving = false;
        if (result is not null)
        {
            showCreate = false;
            newTitle = ""; newDescription = ""; newPriority = 1;
            await LoadTickets();
        }
        else createError = "Fehler beim Erstellen des Tickets.";
    }
}
