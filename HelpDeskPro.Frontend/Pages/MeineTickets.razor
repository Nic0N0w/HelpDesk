@page "/meine-tickets"
@using HelpDeskPro.Frontend.Models
@using HelpDeskPro.Frontend.Services
@inject ApiService Api
@inject AuthState Auth
@inject NavigationManager Nav

<div class="page-header">
    <h2>👤 Meine Tickets</h2>
    <span class="subtitle-tag">Eingeloggt als: <strong>@Auth.CurrentUser?.Name</strong></span>
</div>

@if (isLoading)
{
    <p class="loading">⏳ Tickets werden geladen…</p>
}
else if (!tickets.Any())
{
    <div class="empty-state">
        <p>Du hast noch keine Tickets erstellt oder zugewiesen bekommen.</p>
        <button class="btn-primary" @onclick='() => Nav.NavigateTo("/")'>Zur Ticketliste</button>
    </div>
}
else
{
    <table class="ticket-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Titel</th>
                <th>Status</th>
                <th>Priorität</th>
                <th>Rolle</th>
                <th>Datum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in tickets)
            {
                <tr>
                    <td>@t.Id</td>
                    <td class="ticket-title" @onclick='() => Nav.NavigateTo($"/ticket/{t.Id}")'>@t.Title</td>
                    <td><span class="badge badge-@t.Status.ToString().ToLower()">@t.Status</span></td>
                    <td><span class="badge badge-priority-@t.Priority.ToString().ToLower()">@t.Priority</span></td>
                    <td>
                        @if (t.CreatedByUserId == Auth.CurrentUser?.Id)
                        {
                            <span class="role-tag role-creator">Ersteller</span>
                        }
                        else
                        {
                            <span class="role-tag role-assignee">Zugewiesen</span>
                        }
                    </td>
                    <td>@t.CreatedAt.ToShortDateString()</td>
                    <td><button class="btn-sm" @onclick='() => Nav.NavigateTo($"/ticket/{t.Id}")'>Details</button></td>
                </tr>
            }
        </tbody>
    </table>
    <p class="result-count">@tickets.Count Ticket(s)</p>
}

@code {
    List<TicketDto> tickets = new();
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var result = await Api.GetUserTicketsAsync(Auth.CurrentUser!.Id);
            tickets = result ?? new();
        }
        finally { isLoading = false; }
    }
}
