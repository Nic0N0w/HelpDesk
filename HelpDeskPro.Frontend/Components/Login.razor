@using HelpDeskPro.Frontend.Models
@using HelpDeskPro.Frontend.Services
@inject ApiService Api
@inject AuthState Auth

<div class="login-wrapper">
    <div class="login-card">
        <h1>🖥️ HelpDesk Pro</h1>
        <p class="subtitle">Internes IT-Support-Portal</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-error">@errorMessage</div>
        }

        <div class="form-group">
            <label>Benutzer auswählen</label>
            <select @bind="selectedUserId" class="form-select">
                <option value="0">– Bitte wählen –</option>
                @foreach (var user in users)
                {
                    <option value="@user.Id">@user.Name (@user.Role)</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Passwort (Demo)</label>
            <input type="password" @bind="password" placeholder="beliebig eingeben" class="form-input" />
        </div>

        <button class="btn-primary" @onclick="DoLogin" disabled="@isLoading">
            @(isLoading ? "Wird geladen..." : "Anmelden")
        </button>

        <p class="hint">💡 Demo: Wähle einen Benutzer und gib ein beliebiges Passwort ein.</p>
    </div>
</div>

@code {
    List<UserDto> users = new();
    int selectedUserId = 0;
    string password = "";
    string errorMessage = "";
    bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            users = await Api.GetUsersAsync() ?? new();
        }
        catch
        {
            errorMessage = "API nicht erreichbar. Ist das Backend gestartet? (dotnet run in HelpDeskPro.Api)";
        }
        finally { isLoading = false; }
    }

    async Task DoLogin()
    {
        errorMessage = "";
        if (selectedUserId == 0) { errorMessage = "Bitte einen Benutzer auswählen."; return; }
        if (string.IsNullOrWhiteSpace(password)) { errorMessage = "Bitte ein Passwort eingeben."; return; }

        var user = users.FirstOrDefault(u => u.Id == selectedUserId);
        if (user is not null) Auth.Login(user);
    }
}
