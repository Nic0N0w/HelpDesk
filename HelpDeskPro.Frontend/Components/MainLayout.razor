@inherits LayoutComponentBase
@using HelpDeskPro.Frontend.Models
@using HelpDeskPro.Frontend.Services
@inject AuthState Auth
@inject NavigationManager Nav

<div class="layout">
    <header class="topbar">
        <span class="logo">🖥️ HelpDesk Pro</span>
        <div class="user-info">
            <span class="user-badge">@Auth.CurrentUser?.Name
                <span class="role-chip @(Auth.CurrentUser?.Role == UserRole.Admin ? "chip-admin" : "chip-user")">
                    @Auth.CurrentUser?.Role
                </span>
            </span>
            <button class="btn-logout" @onclick="Logout">Abmelden</button>
        </div>
    </header>

    <nav class="sidebar">
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">📋 Alle Tickets</NavLink>
        <NavLink class="nav-link" href="/meine-tickets">👤 Meine Tickets</NavLink>
        @if (Auth.CurrentUser?.Role == UserRole.Admin)
        {
            <NavLink class="nav-link" href="/admin">⚙️ Admin-Panel</NavLink>
        }
    </nav>

    <main class="content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized() => Auth.OnChange += StateHasChanged;
    public void Dispose() => Auth.OnChange -= StateHasChanged;

    void Logout()
    {
        Auth.Logout();
        Nav.NavigateTo("/", forceLoad: true);
    }
}
