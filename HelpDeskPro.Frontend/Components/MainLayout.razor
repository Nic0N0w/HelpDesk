@inherits LayoutComponentBase
@using HelpDeskPro.Frontend.Services
@inject AuthState Auth
@inject NavigationManager Nav

<div class="layout">
    <header class="topbar">
        <span class="logo">🖥️ HelpDesk Pro</span>
        <div class="user-info">
            <span>@Auth.CurrentUser?.Name (@Auth.CurrentUser?.Role)</span>
            <button class="btn-logout" @onclick="Logout">Abmelden</button>
        </div>
    </header>

    <nav class="sidebar">
        <a href="/">📋 Alle Tickets</a>
        <a href="/meine-tickets">👤 Meine Tickets</a>
        @if (Auth.CurrentUser?.Role == HelpDeskPro.Frontend.Models.UserRole.Admin)
        {
            <a href="/admin">⚙️ Admin</a>
        }
    </nav>

    <main class="content">
        @Body
    </main>
</div>

@code {
    void Logout()
    {
        Auth.Logout();
        Nav.NavigateTo("/", forceLoad: true);
    }
}
